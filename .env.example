# application host and port
HOST=0.0.0.0
PORT=8000

# database
DB_HOST=# get from project owner
DB_PORT=# get from project owner
DB_NAME=# get from project owner
DB_USER=# get from project owner
DB_PASSWORD=# get from project owner

# JWT authentication
JWT_SECRET_KEY=# generate a strong random secret (e.g. openssl rand -hex 32)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7